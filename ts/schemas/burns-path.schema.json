{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurnsPath (path-entry component output)",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "keyframes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "t",
          "rect"
        ],
        "additionalProperties": false
      }
    },
    "interp": {
      "type": "string",
      "const": "linear"
    },
    "easing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        }
      ]
    },
    "output_aspect": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "meta": {
      "type": "object",
      "properties": {
        "preset_id": {
          "type": "string"
        },
        "preset_params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "output_aspect_ratio": {
          "type": "object",
          "properties": {
            "num": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "den": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "keyframes",
    "interp",
    "easing",
    "output_aspect"
  ],
  "additionalProperties": false
}
